@model IEnumerable<User>
@{
    ViewData["Title"] = "Пользователи";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Пользователи</h1>
    <a asp-action="Create" class="btn btn-primary">+ Новый пользователь</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="search" name="search" value="@search" class="form-control"
               placeholder="Поиск по логину, email или ФИО" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Найти</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="btn btn-link">Сбросить</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Пользователи не найдены.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Логин</th>
                        <th>Email</th>
                        <th>ФИО</th>
                        <th>Телефон</th>
                        <th>Зарегистрирован</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.UserName</td>
                        <td>@item.Email</td>
                        <td>@(item.Profile?.FullName ?? "—")</td>
                        <td>@(item.Profile?.PhoneNumber ?? "—")</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Профиль</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
